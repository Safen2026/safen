{
  "expo": {
    "name": "Safen",
    "slug": "safen",
    "scheme": "safen",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/91afa9ad-f350-4ac7-b9f9-255bc59225c7"
    },
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.safen.app",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.kingdave17.safen",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },

    "plugins": [
  "expo-router",
  ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Allow SAFEN to use your location to share it during emergencies." }],
  ["expo-image-picker", { "photosPermission": "Allow SAFEN to access your photos so you can attach evidence to reports.", "cameraPermission": "Allow SAFEN to access your camera to capture evidence for emergency reports." }],
  ["expo-av", { "microphonePermission": "Allow SAFEN to access your microphone to record audio evidence for reports." }],
  ["expo-notifications", { "icon": "./assets/android-icon-monochrome.png", "color": "#00875A" }],
  "@react-native-community/datetimepicker",
  ["@react-native-firebase/app", { "ios": { "useFrameworks": "dynamic" } }],
  "@react-native-firebase/auth"
],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91afa9ad-f350-4ac7-b9f9-255bc59225c7"
      }
    },
    "owner": "kingdave17"
  }
}
