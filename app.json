{
  "expo": {
    "name": "SAFEN",
    "slug": "safen",
    "scheme": "safen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.safen.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "package": "com.safen.app",
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kingdave17.safen"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SAFEN to use your location to share it during emergencies."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SAFEN to access your photos so you can attach evidence to reports.",
          "cameraPermission": "Allow SAFEN to access your camera to capture evidence for emergency reports."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow SAFEN to access your microphone to record audio evidence for reports."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#00875A"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d07b9e3-1a01-46ca-b2e1-5c81bd8a4c25"
      }
    }
  }
}
