# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Secrets
.env
.note.md

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# documentation
# `docs/*` rather than `docs/` so the negation below works — git cannot
# re-include a path whose parent directory is itself excluded.
docs/*
!docs/superpowers/
*.docx
~$*.docx

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# test & scratch scripts
test*.js
test*.ts
test*.png
# rehearsal schema dump (generated from production, not source)
supabase/rehearsal/baseline.sql

# incidental root deno.lock from running tests at the repo root.
# supabase/functions/deno.lock IS tracked — it pins the Anthropic SDK version
# so edge deploys are reproducible.
/deno.lock
