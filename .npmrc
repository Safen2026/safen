# Tells npm to use legacy peer dependency resolution.
# Required because jest-expo@57 pulls in @react-native/jest-preset@0.86.3
# which declares a peer on react@^19.2.3, while the project ships react@19.1.0.
# This flag is picked up by both local `npm install` and EAS `npm ci` runs,
# preventing the ERESOLVE error that was blocking APK builds.
legacy-peer-deps=true
